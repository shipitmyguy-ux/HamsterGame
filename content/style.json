{
  "id": "approved_chibi_pixel_mobile_v1",
  "art_direction": "cute chibi pixel art",
  "inspiration": "cozy indie pixel life sim; original assets only",
  "tile_size": 32,
  "perspective": "top-down slight three-quarter",
  "palette": "warm pastel",
  "character": {
    "large_head": true,
    "round_body": true,
    "short_feet": true,
    "high_expression": true,
    "directional_frames": 4
  },
  "rendering": {
    "nearest_neighbor": true,
    "y_sort": true
  },
  "ui": {
    "touch_first": true,
    "min_touch_target_px": 44,
    "movement": "lower-left",
    "context_actions": "lower-right",
    "hotbar": "bottom",
    "goal": "always readable"
  },
  "generation_rules": [
    "preserve silhouette",
    "transparent background for sprites",
    "consistent light direction",
    "no text baked into sprites",
    "use approved hamster proportions"
  ],
  "asset_standard": {
    "player_frame_px": 32,
    "world_cells": {
      "item": {
        "size_px": 32,
        "gutter_px": 2
      },
      "prop": {
        "size_px": 64,
        "gutter_px": 4
      },
      "structure": {
        "size_px": 96,
        "gutter_px": 4
      }
    },
    "baseline": "bottom aligned inside protected gutter",
    "runtime_world_scale": 1.7,
    "rules": [
      "world sprites must be normalized before runtime",
      "runtime must never hand-crop production sprite sheets",
      "do not trim standardized cells after normalization",
      "opaque pixels may not enter the protected gutter",
      "collision derives from visible content bounds, not full transparent cell"
    ]
  }
}
